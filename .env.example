# Configure o token da API obtido em https://developer.clashofclans.com/
CLASH_API_TOKEN=
# Tags dos dois clãs que o aplicativo pode consultar na API do Clash.
CLAN_TAG1=
CLAN_TAG2=
APP_USERNAME=leader
APP_PASSWORD=change-this-to-a-long-random-password
# Senha exclusiva dos contatos: pelo menos 16 caracteres, diferente de APP_PASSWORD.
# Sem esta configuração, os contatos permanecem bloqueados.
CONTACTS_PASSWORD=
PORT=2025
DATABASE_PATH=/data/clan.db
