# Copy to .env.oracle at the repository root; never commit the real file.
# Public DNS hostname only: no scheme, port, or path.
DOMAIN=imperiobarbaro.com.br
DASHBOARD_DOMAIN=dashboard.imperiobarbaro.com.br
ACME_EMAIL=you@example.com
CLASH_API_TOKEN=
# Quote tags if using a leading #.
CLAN_TAG1=''
CLAN_TAG2=''
APP_USERNAME=leader
# Generate two DIFFERENT passwords with: openssl rand -hex 32
APP_PASSWORD=
CONTACTS_PASSWORD=
# Senha dos avisos personalizados (mínimo 16 caracteres).
NOTIFICATIONS_PASSWORD=
# Senha para liberar antecipadamente o intervalo de 1 hora (mínimo 16 caracteres).
SUPER_NOTIFICATIONS_PASSWORD=
APP_IMAGE_TAG=local
